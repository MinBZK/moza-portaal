# Digitale assistent: backend (github.com/MinBZK/moza-poc-digitale-assistent).
# Leeg: de assistent draait in demo-modus. Publiek bereikbaar via de frontend
# van moza-poc, die /chat, /health en /tools doorstuurt.
ASSISTENT_BACKEND_URL=https://proef.moza.rijksapp.dev

# Berichtenbox: Federatief Berichtenstelsel (berichtenuitvraag) voor de
# aangesloten persona's. Leeg: de testomgeving die moza-poc ook gebruikt.
KETEN_BACKEND_URL=https://uitvraag-test-mpfb-8wh.rig.prd1.gn2.quattro.rijksapps.nl

# Inloggen met NL Wallet (/inloggen/zakelijk, "Inloggen met een wallet"). De
# verification_server draait in MinBZK/moza-wallet-testomgeving (ZAD mwt-ked).
# De interne API is alleen binnen ZAD bereikbaar, met een cross-domain-regel.
# Leeg: localhost, voor een lokale NL Wallet-omgeving.
NL_WALLET_VS_INTERNAL=
NL_WALLET_VS_PUBLIC=https://nlw-verifier.moza-wallet.rijksapp.dev
NL_WALLET_USECASE=moza_inloggen
NL_WALLET_API_KEY=
# Per onderneming de links voor "bevoegdheid toevoegen" (moza.json).
NL_WALLET_CONFIG_URL=
# Download van de testapp NL Wallet MOZa (release bij moza-wallet-testomgeving).
NL_WALLET_APP_URL=
# Leeg: het adres volgt uit het verzoek (Host en X-Forwarded-Proto).
MOZA_PUBLIC_URL=
